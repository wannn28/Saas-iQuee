# Local development (npm run dev). In Docker, DATABASE_URL is built by docker-compose from the MYSQL_* vars.
NODE_ENV=development
PORT=3005
DATABASE_URL=mysql://gapless:change-me@localhost:3306/gapless
CORS_ORIGINS=http://localhost:5173,http://localhost:4175
TRUST_PROXY=0
ADMIN_USER=demo
ADMIN_PASSWORD=change-me-min-8-chars
# random string, used to hash client IPs (openssl rand -hex 16)
IP_HASH_SALT=change-me-change-me
SIGNUP_RATE_LIMIT=8
