{
  "name": "gapless-waitlist-api",
  "version": "1.0.0",
  "private": true,
  "description": "Gapless demo waitlist API - Express + Drizzle ORM + MySQL 8",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:dev": "tsx src/migrate.ts",
    "db:seed": "node dist/seed.js",
    "db:seed:dev": "tsx src/seed.ts",
    "test:api": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "5.6"
  }
}
