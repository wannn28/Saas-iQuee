# docker-compose settings for the saas stack. Copy to .env and replace every value. Never commit .env.
# Generate secrets with: openssl rand -hex 24
MYSQL_DATABASE=gapless
MYSQL_USER=gapless
# hex only (embedded in the DATABASE_URL)
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
API_PORT=3005
CORS_ORIGINS=https://saas.iquee.tech
# Nginx + Cloudflare in front of the API
TRUST_PROXY=2
ADMIN_USER=demo
ADMIN_PASSWORD=change-me-min-8-chars
IP_HASH_SALT=change-me-random-string
SIGNUP_RATE_LIMIT=10
RUN_SEED=true
